---
// The arena page is a single self-contained HTML fragment (apps/arena/index.html,
// also published as a Claude artifact for review). Here it is wrapped in a real
// document and fed the live snapshot: tools with successful runs, the prompts
// they answered, and the runs with audio URLs, timings and scores. With that data
// present the page runs real blind battles from the benchmark cache; without it
// (the artifact) it falls back to fictional placeholders.
import arenaHtml from '../../../arena/index.html?raw';
import { loadSnapshot } from '../lib/snapshot';
import { asset, SITE_NAME } from '../lib/site';

const snap = loadSnapshot();
const runs = snap.runs.filter((r) => r.status === 'success' && r.audio_url).map((r) => ({
  tool: r.tool, prompt_id: r.prompt_id, status: 'success', audio_url: asset(r.audio_url as string), ttft_ms: r.ttft_ms, latency_ms: r.latency_ms, scores: r.scores, composite: r.composite,
}));
const toolSlugs = new Set(runs.map((r) => r.tool));
const data = {
  tools: snap.tools.filter((t) => toolSlugs.has(t.slug)).map((t) => ({ slug: t.slug, name: t.name, vendor: t.vendor, status: t.status })),
  prompts: snap.prompts.map((p) => ({ id: p.id, title: p.title, text: p.text, language: p.language })),
  runs,
  generated_at: snap.generated_at,
};
const json = JSON.stringify(data).replace(/</g, '\\u003c');
const html = arenaHtml
  .replace('<script id="arena-data" type="application/json">{}</script>', `<script id="arena-data" type="application/json">${json}</script>`)
  .replace('<title>Tool Wars</title>', `<title>${SITE_NAME} Arena</title>`);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#15181b" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" />
    <Fragment set:html={html.split('</style>')[0] + '</style>'} />
  </head>
  <body>
    <Fragment set:html={html.split('</style>').slice(1).join('</style>')} />
  </body>
</html>
