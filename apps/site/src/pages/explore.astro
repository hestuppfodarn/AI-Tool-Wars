---
import Base from '../layouts/Base.astro';
import StatusChip from '../components/StatusChip.astro';
import { loadSnapshot, pairsIn, toolsIn, toolBySlug, ratingsIn } from '../lib/snapshot';
import { href, SITE_NAME, modalityWords } from '../lib/site';

const snap = loadSnapshot();
---
<Base title={`${SITE_NAME}: AI tools compared on real outputs`} description="Side-by-side comparisons of AI software built from actual outputs on a fixed prompt set, not feature tables or paid placement." canonicalPath="/explore/">
  <h1>AI tools compared on what they actually produce.</h1>
  <p class="lede">
    Every tool in a category runs the same public prompts. We publish the outputs, score them the same way, and
    keep the scores up to date. No vendor can pay to be here or to rank higher.
  </p>
  <p><a class="btn" href={href('/')}>Enter the arena: hear two tools, pick the winner</a></p>

  {snap.categories.map((c) => {
    const tools = toolsIn(snap, c.slug);
    const pairs = pairsIn(snap, c.slug);
    const ratings = ratingsIn(snap, c.slug);
    return (
      <section>
        <h2><a href={href(`/${c.slug}/`)}>{c.name}</a> <span class="chip">{c.output_modality}</span></h2>
        <p class="muted">{c.description}</p>
        {(() => { const ch = tools.filter((t) => t.status === 'challenged').length; const se = tools.filter((t) => t.status === 'seat_needed').length; const pr = tools.filter((t) => t.proxy).length;
          return (ch + se + pr) > 0 && <p class="small muted">{tools.length} tools: {ratings.length} scored{ch > 0 && <span>, {ch} under standing challenge</span>}{se > 0 && <span>, {se} waiting on a seat</span>}{pr > 0 && <span>, {pr} proxies</span>}. Outputs are {modalityWords(c.output_modality).outputs}. <a href={href('/challenges/')}>Challenges</a>.</p>; })()}
        <div class="grid">
          {tools.map((t) => {
            const r = ratings.find((x) => x.tool === t.slug);
            return (
              <div class="card">
                <div style="display:flex;justify-content:space-between;gap:8px;align-items:center">
                  <strong><a href={href(`/${c.slug}/tools/${t.slug}/`)}>{t.name}</a></strong>
                  <StatusChip status={t.status} asked_on={t.challenge?.asked_on} />
                </div>
                <p class="small muted" style="margin:6px 0 0">{r ? `#${r.rank} · composite ${r.composite.toFixed(1)}` : t.vendor}</p>
              </div>
            );
          })}
        </div>
        <h3 style="margin-top:1.5rem">Comparisons</h3>
        <ul class="list-tight">
          {pairs.map((p) => <li><a href={href(`/${c.slug}/${p.slug}/`)}>{toolBySlug(snap, p.a).name} vs {toolBySlug(snap, p.b).name}</a></li>)}
        </ul>
      </section>
    );
  })}
</Base>
