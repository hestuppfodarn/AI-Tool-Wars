---
import type { Category, Tool } from '../lib/snapshot';
import { claimMailto, href } from '../lib/site';
import { claimsEnabled } from '../lib/supabase';
interface Props { tools: Tool[]; category: Category; }
const { tools, category } = Astro.props;
// With the claims backend configured the buttons go to the self-serve page
// (preselecting the tool); without it they stay a mailto so nothing dead-ends.
const claimHref = (t: Tool) => (claimsEnabled ? `${href('/claim/')}?tool=${encodeURIComponent(t.slug)}` : claimMailto(t.name, category.name));
---
<div class="cta">
  <h3>Is one of these your product?</h3>
  <p>
    Claim your listing and provide an API key. Runs then execute on your account, your listing gets the
    <em>vendor verified</em> mark, and you get an embeddable badge with your live scores. No fee, no placement,
    and the prompts are public, so there is nothing to optimise for except the output.
  </p>
  <p>
    {tools.map((t, i) => <span>{i > 0 ? ' ' : ''}<a class="btn" href={claimHref(t)}>Claim {t.name}</a></span>)}
  </p>
  <p class="small muted">
    Keys are stored encrypted and only ever used to run the published prompt set. Read how in the <a href={href('/methodology/')}>methodology</a>{claimsEnabled ? ' or go straight to the ' : ''}{claimsEnabled && <a href={href('/claim/')}>claim page</a>}.
  </p>
</div>
